{
  "name": "everythingcode/symfony-quickstart",
  "description": "Minimal Symfony API quickstart for the EveryThingCode learning repository.",
  "type": "project",
  "require": {
    "php": "^8.5",
    "symfony/config": "^7.4",
    "symfony/framework-bundle": "^7.4",
    "symfony/runtime": "^7.4",
    "symfony/yaml": "^7.4"
  },
  "require-dev": {
    "phpunit/phpunit": "^12.0"
  },
  "autoload": {
    "psr-4": {
      "App\\": "src/"
    }
  },
  "autoload-dev": {
    "psr-4": {
      "Tests\\": "tests/"
    }
  },
  "scripts": {
    "serve": "APP_ENV=dev APP_DEBUG=1 php -S 127.0.0.1:8001 -t public",
    "test": "phpunit"
  },
  "minimum-stability": "stable",
  "prefer-stable": true
}
