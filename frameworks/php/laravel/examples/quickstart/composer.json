{
  "name": "everythingcode/laravel-quickstart",
  "description": "Minimal Laravel API quickstart for the EveryThingCode learning repository.",
  "type": "project",
  "require": {
    "php": "^8.5",
    "laravel/framework": "^13.0"
  },
  "require-dev": {
    "phpunit/phpunit": "^12.0"
  },
  "autoload": {
    "psr-4": {
      "App\\": "app/"
    }
  },
  "autoload-dev": {
    "psr-4": {
      "Tests\\": "tests/"
    }
  },
  "scripts": {
    "serve": "php artisan serve --host=127.0.0.1 --port=8000",
    "test": "php artisan test"
  },
  "minimum-stability": "stable",
  "prefer-stable": true
}
